ique_id": "test.ecommerce_churn.not_null_stg_transactions_TotalAmount.027b80efe2", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect TotalAmount\nfrom `airy-web-484800-u5`.`ecommerce_churn`.`stg_transactions`\nwhere TotalAmount is null\n\n\n", "relation_name": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-19T02:27:44.999916Z", "completed_at": "2026-01-19T02:27:45.003915Z"}, {"name": "execute", "started_at": "2026-01-19T02:27:45.004467Z", "completed_at": "2026-01-19T02:27:50.316781Z"}], "thread_id": "Thread-1", "execution_time": 5.31796407699585, "adapter_response": {"_message": "CREATE TABLE (4.3k rows, 28.0 MiB processed)", "code": "CREATE TABLE", "rows_affected": 4338, "bytes_processed": 29311951, "bytes_billed": 29360128, "location": "US", "project_id": "airy-web-484800-u5", "job_id": "9be5e6cb-62c0-4a08-9bc7-1f86b6eb9d3e", "slot_ms": 4593}, "message": "CREATE TABLE (4.3k rows, 28.0 MiB processed)", "failures": null, "unique_id": "model.ecommerce_churn.int_customer_rfm", "compiled": true, "compiled_code": "with stg_transactions as (\n    select * from `airy-web-484800-u5`.`ecommerce_churn`.`stg_transactions`\n),\n\nmax_date as (\n    select max(InvoiceDate) as max_invoice_date from stg_transactions\n),\n\ncustomer_group as (\n    select\n        CustomerID,\n        max(InvoiceDate) as LastPurchase,\n        min(InvoiceDate) as FirstPurchase,\n        count(distinct InvoiceNo) as TotalInvoices,\n        count(distinct StockCode) as UniqueProducts,\n        sum(TotalAmount) as TotalSpent\n    from stg_transactions\n    group by CustomerID\n)\n\nselect\n    t.CustomerID,\n    -- RFM Metrics\n    date_diff(m.max_invoice_date, t.LastPurchase, DAY) as Recency,\n    t.TotalInvoices as Frequency,\n    t.TotalSpent as Monetary,\n    \n    -- Time Features\n    t.FirstPurchase,\n    t.LastPurchase,\n    date_diff(t.LastPurchase, t.FirstPurchase, DAY) as CustomerLifetime,\n    date_diff(m.max_invoice_date, t.FirstPurchase, DAY) as DaysSinceFirstPurchase,\n    \n    -- AvgInterPurchaseTime (avoid divide by zero)\n    case \n        when t.TotalInvoices > 1 then date_diff(t.LastPurchase, t.FirstPurchase, DAY) / (t.TotalInvoices - 1)\n        else 0 \n    end as AvgInterPurchaseTime,\n    \n    -- Behavioral Features\n    safe_divide(t.TotalSpent, t.TotalInvoices) as AvgOrderValue,\n    safe_divide(t.UniqueProducts, t.TotalInvoices) as ProductsPerOrder,\n    safe_divide(t.TotalSpent, date_diff(m.max_invoice_date, t.FirstPurchase, DAY) + 1) as SpendingVelocity\n\nfrom customer_group t\ncross join max_date m", "relation_name": "`airy-web-484800-u5`.`ecommerce_churn`.`int_customer_rfm`"}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-01-19T02:27:50.322901Z", "completed_at": "2026-01-19T02:27:50.344751Z"}, {"name": "execute", "started_at": "2026-01-19T02:27:50.346751Z", "completed_at": "2026-01-19T02:27:52.623886Z"}], "thread_id": "Thread-4", "execution_time": 2.3030917644500732, "adapter_response": {"_message": "SELECT (1.0 rows, 33.9 KiB processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 34704, "bytes_billed": 10485760, "location": "US", "project_id": "airy-web-484800-u5", "job_id": "41358809-6c18-45f0-b3f5-1cf44e06a0b5", "slot_ms": 33}, "message": null, "failures": 0, "unique_id": "test.ecommerce_churn.not_null_int_customer_rfm_CustomerID.115b9b3f1c", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect CustomerID\nfrom `airy-web-484800-u5`.`ecommerce_churn`.`int_customer_rfm`\nwhere CustomerID is null\n\n\n", "relation_name": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-01-19T02:27:50.339753Z", "completed_at": "2026-01-19T02:27:50.354751Z"}, {"name": "execute", "started_at": "2026-01-19T02:27:50.358304Z", "completed_at": "2026-01-19T02:27:52.635892Z"}], "thread_id": "Thread-3", "execution_time": 2.303090810775757, "adapter_response": {"_message": "SELECT (1.0 rows, 33.9 KiB processed)", "code": "SELECT",