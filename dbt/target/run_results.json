 "slot_ms": 60}, "message": null, "failures": 0, "unique_id": "test.ecommerce_churn.not_null_int_customer_rfm_Recency.cbc00cd128", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect Recency\nfrom `airy-web-484800-u5`.`ecommerce_churn`.`int_customer_rfm`\nwhere Recency is null\n\n\n", "relation_name": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-01-19T02:27:52.627887Z", "completed_at": "2026-01-19T02:27:52.639910Z"}, {"name": "execute", "started_at": "2026-01-19T02:27:52.639910Z", "completed_at": "2026-01-19T02:27:54.959947Z"}], "thread_id": "Thread-4", "execution_time": 2.3340609073638916, "adapter_response": {"_message": "SELECT (1.0 rows, 33.9 KiB processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 34704, "bytes_billed": 10485760, "location": "US", "project_id": "airy-web-484800-u5", "job_id": "fa36be01-e358-4d49-be66-321a823f9a65", "slot_ms": 46}, "message": null, "failures": 0, "unique_id": "test.ecommerce_churn.unique_int_customer_rfm_CustomerID.7c6fc763e2", "compiled": true, "compiled_code": "\n    \n    \n\nwith dbt_test__target as (\n\n  select CustomerID as unique_field\n  from `airy-web-484800-u5`.`ecommerce_churn`.`int_customer_rfm`\n  where CustomerID is not null\n\n)\n\nselect\n    unique_field,\n    count(*) as n_records\n\nfrom dbt_test__target\ngroup by unique_field\nhaving count(*) > 1\n\n\n", "relation_name": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-19T02:27:54.964033Z", "completed_at": "2026-01-19T02:27:54.968766Z"}, {"name": "execute", "started_at": "2026-01-19T02:27:54.969300Z", "completed_at": "2026-01-19T02:27:59.897300Z"}], "thread_id": "Thread-3", "execution_time": 4.933788537979126, "adapter_response": {"_message": "CREATE TABLE (4.3k rows, 406.7 KiB processed)", "code": "CREATE TABLE", "rows_affected": 4338, "bytes_processed": 416448, "bytes_billed": 10485760, "location": "US", "project_id": "airy-web-484800-u5", "job_id": "d09a1593-fdb7-4fd5-96c5-207001fcf1ec", "slot_ms": 34125}, "message": "CREATE TABLE (4.3k rows, 406.7 KiB processed)", "failures": null, "unique_id": "model.ecommerce_churn.fct_churn_features", "compiled": true, "compiled_code": "with rfm_data as (\n    select * from `airy-web-484800-u5`.`ecommerce_churn`.`int_customer_rfm`\n),\n\nscored_data as (\n    select\n        *,\n        -- Churn Label (90 days threshold)\n        case when Recency > 90 then 1 else 0 end as Churned,\n        \n        -- RFM Scores (1-5)\n        -- Recency: Lower is better (Oldest/Highest Recency -> Score 1, Newest/Lowest Recency -> Score 5)\n        -- NTILE(5) over DESC: 1=Highest(Oldest), 5=Lowest(Newest). Matches Python logic \"1(old) to 5(recent)\".\n        ntile(5) over (order by Recency desc) as RecencyScore,\n        \n        -- Frequency: Higher is better (1=Low, 5=High)\n        -- NTILE(5) over ASC: 1=Lowest, 5=Highest. Matches Python logic.\n        ntile(5) over (order by Frequency asc) as FrequencyScore,\n        \n        -- Monetary: Higher is better (1=Low, 5=High)\n        ntile(5) over (order by Monetary asc) as MonetaryScore\n\n    from rfm_data\n)\n\nselect\n    *,\n    (RecencyScore + FrequencyScore + MonetaryScore) as RFMScore\nfrom scored_data\nwhere Recency is not null\n  and Frequency is not null\n  and Monetary is not null", "relation_name": "`airy-web-484800-u5`.`ecommerce_churn`.`fct_churn_features`"}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-01-19T02:27:59.907538Z", "completed_at": "2026-01-19T02:27:59.956256Z"}, {"name": "execute", "started_at": "2026-01-19T02:27:59.957255Z", "completed_at": "2026-01-19T02:28:02.385410Z"}], "thread_id": "Thread-1", "execution_time": 2.4816086292266846, "adapter_response": {"_message": "SELECT (1.0 rows, 33.9 KiB processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 34704, "bytes_billed": 10485760, "location": "US", "project_id": "airy-web-484800-u5", "job_id": "c4e2ba76-24aa-43d0-9c0a-08d8e34f